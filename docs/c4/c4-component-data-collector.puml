@startuml component diagram data collector
!include <C4/C4_Component>

title Data Collector Module - Component Diagram

System_Ext(broker, "HyperLiquid API", "Levert realtime en historische marktdata.")
ContainerDb_Ext(db,"PostgreSQL","PostgreSQL","Historische marktdata en uitgevoerde trades.")
Container_Ext(trader, "Automated Trading Module", "Python", "Voert strategieën uit op realtime marktdata en plaatst orders.")

Container_Boundary(data, "Data Collector Module") {

    Component(rest, "Historical Data Client","Python","Haalt historische marktdata op via de HyperLiquid REST API.")

    Component(ws, "Live Data Client","Python","Ontvangt realtime marktdata via de HyperLiquid WebSocket.")

    Component(processor, "Data Processor","Python","Valideert, normaliseert en verwerkt marktdata.")

    Component(repository, "Data Repository","Python","Slaat historische marktdata op in PostgreSQL.")

    Component(publisher, "Data Publisher","Python","Distribueert realtime marktdata naar de Trading Engine.")
}

Rel(rest, broker, "Haalt historische data op", "REST API")
Rel(ws, broker, "Ontvangt live marktdata", "WebSocket")

Rel(rest, processor, "Historische data")
Rel(ws, processor, "Live data")
Rel(processor, repository, "Opslaan")
Rel(processor, publisher, "Publiceert")

Rel(repository, db, "Scrijft historische marktdata", "SQL")
Rel(publisher, trader, "Stuurt live marktdata", "WebSocket")
@enduml