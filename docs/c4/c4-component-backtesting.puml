@startuml component diagram backtesting engine
!include <C4/C4_Component>

title Backtesting Module - Component Diagram

ContainerDb_Ext(db,"PostgreSQL","PostgreSQL","Historische marktdata en uitgevoerde trades.")

Container_Boundary(backtest, "Backtesting Module") {
    Component(simulator,"Trade Simulator","Python","Splitst de marktdata op in train- en testset en voert de strategie uit op testset.")

    Component(analyzer,"Performance Analyzer","Python","Geeft resultaten van de backtest weer in diverse diagrammen en statistieken.")

    Component(repository,"Results Repository","Python","Slaat backtestresultaten op.")
}

Rel(simulator, db, "Haalt historische marktdata en strategieconfiguraties op")
Rel(simulator, analyzer, "Levert trades")
Rel(analyzer, repository, "Stuurt backtestresultaten")
Rel(repository, db, "Slaat backtestresultaten op")
@enduml