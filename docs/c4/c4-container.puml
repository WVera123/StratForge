@startuml container diagram StratForge
!include <C4/C4_Container>

LAYOUT_WITH_LEGEND()

title StratForge - Container Diagram

Person(user, "Gebruiker", "Configureert, previewt en backtest tradingstrategieën en bekijkt resultaten.")

System_Boundary(stratforge, "Software System: StratForge") {
    Container(frontend, "Frontend", "React 19, JavaScript, Vite", "Biedt het gebruikersinterface voor strategiebeheer, previews, backtests, wiki en instellingen.")

    Container(backend, "Backend", "Python, FastAPI, Pydantic", "Biedt de applicatielogica via REST API's. Bestaat uit de Strategy, Backtesting, Data Collector en voorgestelde Paper Trading modules.")


}

ContainerDb_Ext(db, "PostgreSQL Database", "PostgreSQL", "Slaat historische candledata, strategieën, instellingen, backtests en trades op.")

Rel(user, frontend, "Gebruikt", "Browser / HTTP")
Rel(frontend, backend, "Roep functies aan", "JSON / REST API")
Rel(backend, db, "Leest en schrijft data", "SQLAlchemy / SQL")

@enduml